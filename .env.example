# Zerion API key (zk_dev_...). Server-side only: no VITE_ prefix, never reaches the bundle.
ZERION_API_KEY=
# Wallet used by scripts/probe.mjs to pick the demo chain.
DEMO_ADDRESS=
# Alchemy RPC URL with your key (https://<network>.g.alchemy.com/v2/<key>). Server-side only, like the Zerion key.
# Only the key is used; each chain picks its own network.
ALCHEMY_URL=
